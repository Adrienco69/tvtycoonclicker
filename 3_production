Production = object
  creer = function(bloc, numero)
    p = object
    end

    p.bloc_id = bloc.id
    p.bloc_nom = bloc.nom
    p.numero = numero

    p.niveau = 1
    p.niveau_max = numero * 100

    pas_gain = bloc.gain_pas
    decalage_gain = numero - 1
    ajout_gain = decalage_gain * pas_gain
    p.gain_base = bloc.gain_base + ajout_gain
    p.gain_bonus = 0

    p.cout_niveau = p.gain_base * 2

    if bloc.id == "shortcom" then
      p.temps_base = numero * 10
      p.temps_min = numero
    elsif bloc.id == "serie" then
      p.temps_base = numero * 200
      p.temps_min = 10
    elsif bloc.id == "telefilm" then
      decalage_temps = numero - 1
      ajout_temps = decalage_temps * 20
      p.temps_base = 400 + ajout_temps
      p.temps_min = 10
    elsif bloc.id == "tvreal" then
      decalage_temps = numero - 1
      ajout_temps = decalage_temps * 30
      p.temps_base = 800 + ajout_temps
      p.temps_min = 10
    else
      p.temps_base = numero * 10
      p.temps_min = 10
    end

    p.temps_courant = p.temps_base
    p.temps_restant = 0
    p.en_cours = false

    p.debloquee = false

    p.amelioration = 0
    p.amelioration_max = bloc.ameliorations

    p.auto_duree_minutes = 0
    p.auto_restant = 0
    p.auto_illimite = false

    return p
  end

  gain_niveau = function(p)
    gain = p.gain_base * p.niveau
    bonus = p.gain_bonus / 100
    multiplicateur = 1 + bonus
    gain = gain * multiplicateur
    return floor(gain)
  end

  temps_niveau = function(p)
    if p.niveau <= 1 then
      return p.temps_base
    end

    if p.niveau >= p.niveau_max then
      return p.temps_min
    end

    niveau_ecoule = p.niveau - 1
    niveaux_total = p.niveau_max - 1
    progression = niveau_ecoule / niveaux_total

    ecart_temps = p.temps_base - p.temps_min
    reduction = ecart_temps * progression
    t = p.temps_base - reduction

    if t < p.temps_min then
      t = p.temps_min
    end

    return round(t)
  end

  cout_suivant = function(p)
    if p.niveau >= p.niveau_max then
      return 0
    end

    return floor(p.cout_niveau)
  end

  acheter_niveau = function(p)
    if p.niveau >= p.niveau_max then
      return false
    end

    cout = p.cout_niveau

    if Economie.cc < cout then
      return false
    end

    Economie.cc = Economie.cc - cout
    p.niveau = p.niveau + 1

    dizaine = floor(p.niveau / 10)
    reste = p.niveau - dizaine * 10

    if reste == 0 then
      p.cout_niveau = p.cout_niveau * 2
    else
      p.cout_niveau = p.cout_niveau + p.gain_base
    end

    p.temps_courant = temps_niveau(p)
    return true
  end

  lancer = function(p)
    if p.en_cours then
      return false
    end

    p.temps_courant = temps_niveau(p)
    p.temps_restant = p.temps_courant
    p.en_cours = true

    return true
  end
end
