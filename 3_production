Production = object
  creer = function(bloc, numero)
    p = object
    end

    p.bloc_id = bloc.id
    p.bloc_nom = bloc.nom
    p.numero = numero
    p.nom = Donnees.nom_programme(bloc.id,numero,bloc.nom+" "+numero)

    p.niveau = 1
    p.niveau_max = numero * 100

    progression = bloc.progression_gain
    decalage = numero - 1
    ajout = decalage * progression

    p.gain_base = bloc.gain_base + ajout
    p.gain_competence = 0

    p.cout_niveau = p.gain_base * 2

    if bloc.id == "shortcom" then
      p.temps_base = numero * 10
      p.temps_min = numero
    elsif bloc.id == "serie" then
      p.temps_base = numero * 200
      p.temps_min = 10
    elsif bloc.id == "telefilm" then
      decalage_temps = numero - 1
      ajout_temps = decalage_temps * 20
      p.temps_base = 400 + ajout_temps
      p.temps_min = 10
    elsif bloc.id == "tvreal" then
      decalage_temps = numero - 1
      ajout_temps = decalage_temps * 30
      p.temps_base = 800 + ajout_temps
      p.temps_min = 10
    else
      p.temps_base = numero * 10
      p.temps_min = 10
    end

    p.temps_courant = p.temps_base
    p.temps_restant = 0
    p.en_cours = false

    p.debloquee = false

    p.competence = 0
    p.competence_max = Donnees.nombre_competences(bloc.id)

    p.auto_duree_minutes = 0
    p.auto_restant = 0
    p.auto_illimite = false

    return p
  end

  gain_normal = function(p)
    gain = p.gain_base * p.niveau
    return floor(gain)
  end

  gain_competence_total = function(p)
    total = 0
    niveau_competence = 1

    while niveau_competence <= p.competence
      competence = Donnees.get_competence(p.bloc_id,niveau_competence)

      if competence != 0 then
        if niveau_competence % 2 == 1 then
          total = total + competence.valeur
        end
      end

      niveau_competence = niveau_competence + 1
    end

    return floor(total)
  end

  gain_niveau = function(p)
    gain = gain_normal(p)
    gain = gain + gain_competence_total(p)
    return floor(gain)
  end

  temps_niveau = function(p)
    if p.niveau <= 1 then
      return p.temps_base
    end

    if p.niveau >= p.niveau_max then
      return p.temps_min
    end

    niveau_ecoule = p.niveau - 1
    niveaux_total = p.niveau_max - 1
    progression_temps = niveau_ecoule / niveaux_total

    ecart_temps = p.temps_base - p.temps_min
    reduction = ecart_temps * progression_temps
    temps = p.temps_base - reduction

    if temps < p.temps_min then
      temps = p.temps_min
    end

    return round(temps)
  end

  cout_suivant = function(p)
    if p.niveau >= p.niveau_max then
      return 0
    end

    return floor(p.cout_niveau)
  end

  cout_niveaux = function(p, quantite)
    if p.niveau >= p.niveau_max then
      return 0
    end

    niveau_test = p.niveau
    cout_test = p.cout_niveau
    total = 0
    achetes = 0

    while achetes < quantite and niveau_test < p.niveau_max
      total = total + cout_test
      niveau_test = niveau_test + 1

      dizaine = floor(niveau_test / 10)
      reste = niveau_test - dizaine * 10

      if reste == 0 then
        cout_test = cout_test * 2
      else
        cout_test = cout_test + p.gain_base
      end

      achetes = achetes + 1
    end

    return floor(total)
  end

  cout_max = function(p)
    restant = p.niveau_max - p.niveau

    if restant <= 0 then
      return 0
    end

    return cout_niveaux(p,restant)
  end

  acheter_niveau = function(p)
    if p.niveau >= p.niveau_max then
      return false
    end

    cout = p.cout_niveau

    if Economie.cc < cout then
      return false
    end

    Economie.cc = Economie.cc - cout
    p.niveau = p.niveau + 1

    dizaine = floor(p.niveau / 10)
    reste = p.niveau - dizaine * 10

    if reste == 0 then
      p.cout_niveau = p.cout_niveau * 2
    else
      p.cout_niveau = p.cout_niveau + p.gain_base
    end

    p.temps_courant = temps_niveau(p)
    return true
  end

  acheter_niveaux = function(p, quantite)
    achetes = 0

    while achetes < quantite
      if not acheter_niveau(p) then
        return achetes
      end

      achetes = achetes + 1
    end

    return achetes
  end

  acheter_max = function(p)
    achetes = 0

    while p.niveau < p.niveau_max
      if not acheter_niveau(p) then
        return achetes
      end

      achetes = achetes + 1
    end

    return achetes
  end

  lancer = function(p)
    if p.en_cours then
      return false
    end

    p.temps_courant = temps_niveau(p)
    p.temps_restant = p.temps_courant
    p.en_cours = true

    return true
  end
end
