Interface = object
  est_mobile = function()
    if screen.height > screen.width then
      return true
    end

    if system.inputs.touch and not system.inputs.mouse then
      return true
    end

    return false
  end

  dans_bouton = function(x,y,w,h)
    return mouse.x >= x-w/2 and mouse.x <= x+w/2 and mouse.y >= y-h/2 and mouse.y <= y+h/2
  end

  bouton = function(x,y,w,h,texte,couleur,taille)
    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y,taille,"#FFFFFF")
  end

  nb_productions_debloquees = function(bloc)
    total = 0
    for prod in bloc.productions
      if prod.debloquee then
        total = total + 1
      end
    end
    return total
  end

  nb_blocs_debloques = function()
    total = 0
    for bloc in GestionBlocs.blocs
      if bloc.debloque then
        total = total + 1
      end
    end
    return total
  end

  production_actuelle = function()
    if GestionBlocs.blocs.length == 0 then
      return 0
    end

    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if selection_production >= bloc.productions.length then
      selection_production = bloc.productions.length - 1
    end

    return bloc.productions[selection_production]
  end

  clic_navigation = function(gauche_x,droite_x,prod_y,bloc_y,w_prod,h_prod,w_bloc,h_bloc)
    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if nb_productions_debloquees(bloc) > 1 then
      if dans_bouton(gauche_x,prod_y,w_prod,h_prod) then
        if selection_production > 0 then
          selection_production = selection_production - 1
        end
        return true
      end

      if dans_bouton(droite_x,prod_y,w_prod,h_prod) then
        suivant_prod = selection_production + 1
        if suivant_prod < bloc.productions.length then
          if bloc.productions[suivant_prod].debloquee then
            selection_production = suivant_prod
          end
        end
        return true
      end
    end

    if nb_blocs_debloques() > 1 then
      if dans_bouton(gauche_x,bloc_y,w_bloc,h_bloc) then
        if GestionBlocs.bloc_actif > 0 then
          GestionBlocs.bloc_actif = GestionBlocs.bloc_actif - 1
          selection_production = 0
        end
        return true
      end

      if dans_bouton(droite_x,bloc_y,w_bloc,h_bloc) then
        suivant_bloc = GestionBlocs.bloc_actif + 1
        if suivant_bloc < GestionBlocs.blocs.length then
          if GestionBlocs.blocs[suivant_bloc].debloque then
            GestionBlocs.bloc_actif = suivant_bloc
            selection_production = 0
          end
        end
        return true
      end
    end

    return false
  end

  update_pc = function()
    if clic_navigation(-154,154,42,60,20,18,20,16) then
      return
    end

    p = production_actuelle()
    if p == 0 then return end
    if not p.debloquee then return end

    if dans_bouton(0,0,128,22) then
      Production.lancer(p)
      return
    end

    if dans_bouton(-56,-28,96,20) then
      Production.acheter_niveau(p)
      return
    end

    if dans_bouton(56,-28,96,20) then
      Ameliorations.acheter(p)
      return
    end

    if dans_bouton(0,-54,128,16) then
      Ameliorations.recharger_auto(p)
      return
    end
  end

  update_mobile = function()
    if clic_navigation(-78,78,82,125,32,32,32,28) then
      return
    end

    p = production_actuelle()
    if p == 0 then return end
    if not p.debloquee then return end

    if dans_bouton(0,22,170,44) then
      Production.lancer(p)
      return
    end

    if dans_bouton(0,-35,170,34) then
      Production.acheter_niveau(p)
      return
    end

    if dans_bouton(0,-78,170,34) then
      Ameliorations.acheter(p)
      return
    end

    if dans_bouton(0,-121,170,30) then
      Ameliorations.recharger_auto(p)
      return
    end
  end

  update = function()
    if not mouse.press then return end
    if GestionBlocs.blocs.length == 0 then return end

    if est_mobile() then
      update_mobile()
    else
      update_pc()
    end
  end

  texte_production = function(p)
    texte = "PRODUIRE"
    if p.en_cours then
      texte = "Production : "+ceil(p.temps_restant)+" s"
    end
    return texte
  end

  texte_auto = function(p)
    if p.auto_illimite then
      return "AUTO ILLIMITÉE"
    end

    if p.auto_duree_minutes > 0 then
      if p.auto_restant > 0 then
        return "AUTO : "+ceil(p.auto_restant)+" s"
      end
      return "RECHARGER AUTO "+p.auto_duree_minutes+" min"
    end

    return "AUTO À DÉBLOQUER"
  end

  texte_amelioration = function(p)
    if p.amelioration >= p.amelioration_max then
      return "AMÉLIORATIONS MAX"
    end

    prochain = p.amelioration + 1
    prix = Ameliorations.cout(p,prochain)
    paire = floor(prochain / 2) * 2

    if paire != prochain then
      bonus = Ameliorations.bonus_gain_cible(p,prochain)
      return "+"+bonus+"% = "+prix+" CC"
    end

    minutes = Ameliorations.auto_minutes(p,prochain)
    if minutes == -1 then
      return "AUTO ∞ = "+prix+" CC"
    end

    return "AUTO "+minutes+" MIN = "+prix+" CC"
  end

  texte_prochain = function(bloc,p)
    index_suivant = p.numero

    if index_suivant < bloc.productions.length then
      suivant = bloc.productions[index_suivant]

      if not suivant.debloquee then
        seuil = p.numero * 50
        return "Prochain : "+suivant.bloc_nom+" "+suivant.numero+" au niveau "+seuil
      end
    end

    if GestionBlocs.bloc_actif + 1 < GestionBlocs.blocs.length then
      bloc_suivant = GestionBlocs.blocs[GestionBlocs.bloc_actif + 1]
      if not bloc_suivant.debloque then
        cible = bloc.total - 4
        return "Bloc suivant : "+bloc_suivant.nom+" à "+bloc.nom+" "+cible
      end
    end

    return "Tous les déblocages disponibles sont atteints"
  end

  dessiner_pc = function(bloc,p)
    screen.drawText("TV TYCOON CLICKER",0,92,11,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,80,9,"#FFD45A")

    if nb_blocs_debloques() > 1 then
      bouton(-154,60,20,16,"<","#39465C",7)
      bouton(154,60,20,16,">","#39465C",7)
    end
    screen.drawText(bloc.nom,0,60,10,"#BFE1FF")

    if nb_productions_debloquees(bloc) > 1 then
      bouton(-154,42,20,18,"<","#39465C",7)
      bouton(154,42,20,18,">","#39465C",7)
    end

    if not p.debloquee then
      screen.drawText("Production verrouillée",0,22,10,"#AAAAAA")
      return
    end

    screen.drawText(p.bloc_nom+" "+p.numero,0,42,12,"#FFFFFF")
    screen.drawText("Niveau "+p.niveau+" / "+p.niveau_max,0,30,7,"#C8D0DE")
    screen.drawText("Gain : "+Production.gain_niveau(p)+" CC  (+"+p.gain_bonus+"%)",0,20,7,"#8FE59C")

    bouton(0,0,128,22,texte_production(p),"#2D8B62",7)

    cout_niveau = Production.cout_suivant(p)
    if cout_niveau == 0 then
      bouton(-56,-28,96,20,"NIVEAU MAX","#555B66",6)
    else
      bouton(-56,-28,96,20,"NIV+1  "+cout_niveau+" CC","#3C6FA8",6)
    end

    if p.amelioration >= p.amelioration_max then
      bouton(56,-28,96,20,"AMÉLIORATIONS MAX","#555B66",5)
    else
      bouton(56,-28,96,20,texte_amelioration(p),"#7652A8",5)
    end

    if p.auto_illimite or p.auto_duree_minutes > 0 then
      bouton(0,-54,128,16,texte_auto(p),"#9A7726",5)
    else
      bouton(0,-54,128,16,texte_auto(p),"#555B66",5)
    end

    screen.drawText("Temps : "+Production.temps_niveau(p)+" s",0,-71,5,"#AAB4C4")
    screen.drawText(texte_prochain(bloc,p),0,-80,4,"#8993A3")
  end

  dessiner_mobile = function(bloc,p)
    screen.drawText("TV TYCOON CLICKER",0,164,15,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,146,11,"#FFD45A")

    if nb_blocs_debloques() > 1 then
      bouton(-78,125,32,28,"<","#39465C",10)
      bouton(78,125,32,28,">","#39465C",10)
    end
    screen.drawText(bloc.nom,0,125,12,"#BFE1FF")

    if nb_productions_debloquees(bloc) > 1 then
      bouton(-78,82,32,32,"<","#39465C",10)
      bouton(78,82,32,32,">","#39465C",10)
    end

    if not p.debloquee then
      screen.drawText("Production verrouillée",0,45,12,"#AAAAAA")
      return
    end

    screen.drawText(p.bloc_nom+" "+p.numero,0,91,14,"#FFFFFF")
    screen.drawText("Niveau "+p.niveau+" / "+p.niveau_max,0,68,9,"#C8D0DE")
    screen.drawText("Gain : "+Production.gain_niveau(p)+" CC  (+"+p.gain_bonus+"%)",0,54,8,"#8FE59C")

    bouton(0,22,170,44,texte_production(p),"#2D8B62",10)

    cout_niveau = Production.cout_suivant(p)
    if cout_niveau == 0 then
      bouton(0,-35,170,34,"NIVEAU MAX","#555B66",9)
    else
      bouton(0,-35,170,34,"NIVEAU +1  "+cout_niveau+" CC","#3C6FA8",9)
    end

    if p.amelioration >= p.amelioration_max then
      bouton(0,-78,170,34,"AMÉLIORATIONS MAX","#555B66",8)
    else
      bouton(0,-78,170,34,texte_amelioration(p),"#7652A8",7)
    end

    if p.auto_illimite or p.auto_duree_minutes > 0 then
      bouton(0,-121,170,30,texte_auto(p),"#9A7726",7)
    else
      bouton(0,-121,170,30,texte_auto(p),"#555B66",7)
    end

    screen.drawText("Temps : "+Production.temps_niveau(p)+" s",0,-151,7,"#AAB4C4")
    screen.drawText(texte_prochain(bloc,p),0,-164,6,"#8993A3")
  end

  dessiner = function()
    screen.clear("#151821")

    if GestionBlocs.blocs.length == 0 then
      return
    end

    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]
    p = production_actuelle()

    if p == 0 then
      return
    end

    if est_mobile() then
      dessiner_mobile(bloc,p)
    else
      dessiner_pc(bloc,p)
    end
  end
end
