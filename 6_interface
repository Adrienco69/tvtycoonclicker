Interface = object
  est_mobile = function()
    if screen.height > screen.width then
      return true
    end

    if system.inputs.touch and not system.inputs.mouse then
      return true
    end

    return false
  end

  dans_bouton = function(x,y,w,h)
    return mouse.x >= x-w/2 and mouse.x <= x+w/2 and mouse.y >= y-h/2 and mouse.y <= y+h/2
  end

  bouton = function(x,y,w,h,texte,couleur,taille)
    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y,taille,"#FFFFFF")
  end

  bouton_niveau = function(x,y,w,h,texte,cout,actif)
    couleur = "#3C6FA8"

    if not actif then
      couleur = "#555B66"
    end

    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y+2,4,"#FFFFFF")
    screen.drawText(cout,x,y-3,3,"#DCE8F7")
  end

  bouton_niveau_mobile = function(x,y,w,h,texte,cout,actif)
    couleur = "#3C6FA8"

    if not actif then
      couleur = "#555B66"
    end

    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y+2,3,"#FFFFFF")
    screen.drawText(cout,x,y-2,2,"#DCE8F7")
  end

  peut_acheter_niveaux = function(p,quantite)
    cout = Production.cout_niveaux(p,quantite)

    if cout <= 0 then
      return false
    end

    return Economie.cc >= cout
  end

  peut_acheter_competence = function(p)
    if p.competence >= p.competence_max then
      return false
    end

    cout = Ameliorations.cout(p,p.competence+1)
    return Economie.cc >= cout
  end

  bouton_competence = function(x,y,w,h,texte,cout,actif)
    couleur = "#7652A8"

    if not actif then
      couleur = "#555B66"
    end

    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y+2,3,"#FFFFFF")
    screen.drawText(cout,x,y-3,3,"#E9DDF7")
  end

  bouton_competence_mobile = function(x,y,w,h,texte,cout,actif)
    couleur = "#7652A8"

    if not actif then
      couleur = "#555B66"
    end

    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y+2,3,"#FFFFFF")
    screen.drawText(cout,x,y-2,2,"#E9DDF7")
  end

  peut_bloc_gauche = function()
    return GestionBlocs.bloc_actif > 0
  end

  peut_bloc_droite = function()
    suivant = GestionBlocs.bloc_actif + 1

    if suivant >= GestionBlocs.blocs.length then
      return false
    end

    return GestionBlocs.blocs[suivant].debloque
  end

  progression_production = function(p)
    if not p.en_cours then
      return 0
    end

    if p.temps_courant <= 0 then
      return 0
    end

    progression = 1 - p.temps_restant / p.temps_courant

    if progression < 0 then
      progression = 0
    end

    if progression > 1 then
      progression = 1
    end

    return progression
  end

  progression_auto = function(p)
    if p.auto_illimite then
      return 1
    end

    if p.auto_duree_minutes <= 0 then
      return 0
    end

    total = p.auto_duree_minutes * 60

    if total <= 0 then
      return 0
    end

    progression = p.auto_restant / total

    if progression < 0 then
      progression = 0
    end

    if progression > 1 then
      progression = 1
    end

    return progression
  end

  barre = function(x,y,w,h,progression,couleur_fond,couleur_remplissage)
    screen.fillRect(x,y,w,h,couleur_fond)

    if progression > 0 then
      largeur = w * progression
      debut = x - w/2 + largeur/2
      screen.fillRect(debut,y,largeur,h,couleur_remplissage)
    end
  end

  texte_auto_court = function(p)
    if p.auto_illimite then
      return "AUTO ∞"
    end

    if p.auto_duree_minutes <= 0 then
      return "AUTO -"
    end

    if p.auto_restant > 0 then
      return "AUTO "+ceil(p.auto_restant)+"s"
    end

    return "AUTO "+p.auto_duree_minutes+"m"
  end

  texte_gain = function(p)
    normal = Production.gain_normal(p)
    bonus = Production.gain_competence_total(p)

    if bonus > 0 then
      return normal+" CC (+"+bonus+" CC)"
    end

    return normal+" CC"
  end

  texte_niveau = function(p)
    cout = Production.cout_suivant(p)

    if cout == 0 then
      return p.niveau+"/"+p.niveau_max+" (MAX)"
    end

    return p.niveau+"/"+p.niveau_max+" ("+cout+" CC)"
  end

  texte_cout_achat = function(p,quantite)
    cout = Production.cout_niveaux(p,quantite)

    if cout <= 0 then
      return "(MAX)"
    end

    return "("+cout+" CC)"
  end

  texte_cout_competence = function(p)
    if p.competence >= p.competence_max then
      return "(MAX)"
    end

    cout = Ameliorations.cout(p,p.competence+1)
    return "("+cout+" CC)"
  end

  prochain_programme = function(bloc)
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if not p.debloquee then
        if index > 0 then
          precedent = bloc.productions[index-1]
          seuil = precedent.numero * 10
          return "Prochain programme : niveau "+seuil
        end
      end

      index = index + 1
    end

    return "Tous les programmes du bloc sont débloqués"
  end

  clic_bloc_pc = function()
    if peut_bloc_gauche() then
      if dans_bouton(-150,67,20,16) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif - 1
        selection_production = 0
        return true
      end
    end

    if peut_bloc_droite() then
      if dans_bouton(150,67,20,16) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif + 1
        selection_production = 0
        return true
      end
    end

    return false
  end

  clic_bloc_mobile = function()
    if peut_bloc_gauche() then
      if dans_bouton(-82,152,28,24) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif - 1
        selection_production = 0
        return true
      end
    end

    if peut_bloc_droite() then
      if dans_bouton(82,152,28,24) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif + 1
        selection_production = 0
        return true
      end
    end

    return false
  end

  update_lignes_pc = function(bloc)
    y = 47
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        if dans_bouton(-42,y,24,10) then
          selection_production = index
          Production.lancer(p)
          return true
        end

        if dans_bouton(10,y-3,76,5) then
          selection_production = index

          if p.auto_illimite or p.auto_duree_minutes > 0 then
            Ameliorations.recharger_auto(p)
          end

          return true
        end

        if dans_bouton(62,y,22,10) then
          selection_production = index

          if peut_acheter_niveaux(p,1) then
            Production.acheter_niveau(p)
          end

          return true
        end

        if dans_bouton(89,y,26,10) then
          selection_production = index

          if peut_acheter_niveaux(p,5) then
            Production.acheter_niveaux(p,5)
          end

          return true
        end

        if dans_bouton(118,y,28,10) then
          selection_production = index

          if peut_acheter_niveaux(p,10) then
            Production.acheter_niveaux(p,10)
          end

          return true
        end

        if dans_bouton(156,y,44,12) then
          selection_production = index
          Ameliorations.acheter(p)
          return true
        end

        if dans_bouton(-5,y,360,14) then
          selection_production = index
          return true
        end

        y = y - 18
      end

      index = index + 1
    end

    return false
  end

  update_lignes_mobile = function(bloc)
    y = 102
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        if dans_bouton(0,y,190,54) then
          selection_production = index
        end

        if dans_bouton(-63,y-11,34,10) then
          selection_production = index
          Production.lancer(p)
          return true
        end

        if dans_bouton(17,y-19,124,6) then
          selection_production = index

          if p.auto_illimite or p.auto_duree_minutes > 0 then
            Ameliorations.recharger_auto(p)
          end

          return true
        end

        if dans_bouton(-58,y-28,28,8) then
          selection_production = index

          if peut_acheter_niveaux(p,1) then
            Production.acheter_niveau(p)
          end

          return true
        end

        if dans_bouton(-10,y-28,28,8) then
          selection_production = index

          if peut_acheter_niveaux(p,5) then
            Production.acheter_niveaux(p,5)
          end

          return true
        end

        if dans_bouton(38,y-28,28,8) then
          selection_production = index

          if peut_acheter_niveaux(p,10) then
            Production.acheter_niveaux(p,10)
          end

          return true
        end

        if dans_bouton(74,y-28,58,10) then
          selection_production = index
          Ameliorations.acheter(p)
          return true
        end

        y = y - 58
      end

      index = index + 1
    end

    return false
  end

  update_pc = function()
    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if clic_bloc_pc() then
      return
    end

    update_lignes_pc(bloc)
  end

  update_mobile = function()
    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if clic_bloc_mobile() then
      return
    end

    update_lignes_mobile(bloc)
  end

  update = function()
    if not mouse.press then
      return
    end

    if GestionBlocs.blocs.length == 0 then
      return
    end

    if est_mobile() then
      update_mobile()
    else
      update_pc()
    end
  end

  dessiner_ligne_pc = function(p,index,y)
    selection = index == selection_production

    if selection then
      screen.fillRect(-5,y,360,14,"#283247")
    else
      screen.fillRect(-5,y,360,14,"#243148")
    end

    screen.drawText(p.nom,-150,y,4,"#FFFFFF")
    screen.drawText(texte_gain(p),-118,y,4,"#8FE59C")
    screen.drawText(texte_niveau(p),-82,y,4,"#C8D0DE")

    bouton(-42,y,24,10,"LANCER","#2D8B62",3)

    prod = progression_production(p)
    barre(10,y+2,76,5,prod,"#38414F","#2D8B62")

    if p.en_cours then
      screen.drawText(ceil(p.temps_restant)+"s",10,y+2,3,"#FFFFFF")
    else
      screen.drawText("PROD",10,y+2,3,"#FFFFFF")
    end

    auto = progression_auto(p)
    barre(10,y-3,76,5,auto,"#38414F","#9A7726")
    screen.drawText(texte_auto_court(p),10,y-3,3,"#FFFFFF")

    bouton_niveau(62,y,22,10,"+1",texte_cout_achat(p,1),peut_acheter_niveaux(p,1))
    bouton_niveau(89,y,26,10,"+5",texte_cout_achat(p,5),peut_acheter_niveaux(p,5))
    bouton_niveau(118,y,28,10,"+10",texte_cout_achat(p,10),peut_acheter_niveaux(p,10))
    bouton_competence(156,y,40,10,"COMPÉTENCE "+p.competence+"/"+p.competence_max,texte_cout_competence(p),peut_acheter_competence(p))
  end

  dessiner_lignes_pc = function(bloc)
    y = 47
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        dessiner_ligne_pc(p,index,y)
        y = y - 18
      end

      index = index + 1
    end
  end

  dessiner_ligne_mobile = function(p,index,y)
    selection = index == selection_production

    couleur = "#243148"

    if selection then
      couleur = "#2A3953"
    end

    screen.fillRect(0,y,190,54,couleur)

    screen.drawText(p.nom,-74,y+20,4,"#FFFFFF")
    screen.drawText(texte_gain(p),74,y+20,4,"#8FE59C")

    screen.drawText("Niv "+p.niveau+"/"+p.niveau_max,-68,y+11,4,"#C8D0DE")

    cout_txt = Production.cout_suivant(p)

    if cout_txt == 0 then
      screen.drawText("(MAX)",72,y+11,4,"#C8D0DE")
    else
      screen.drawText("("+cout_txt+" CC)",72,y+11,4,"#C8D0DE")
    end

    bouton(-63,y-11,34,10,"LANCER","#2D8B62",3)

    prod = progression_production(p)
    barre(17,y-11,124,6,prod,"#38414F","#2D8B62")

    if p.en_cours then
      screen.drawText("PROD "+ceil(p.temps_restant)+"s",17,y-11,3,"#FFFFFF")
    else
      screen.drawText("PROD",17,y-11,3,"#FFFFFF")
    end

    auto = progression_auto(p)
    barre(17,y-19,124,6,auto,"#38414F","#9A7726")
    screen.drawText(texte_auto_court(p),17,y-19,3,"#FFFFFF")

    bouton_niveau_mobile(-58,y-28,28,8,"+1",texte_cout_achat(p,1),peut_acheter_niveaux(p,1))
    bouton_niveau_mobile(-10,y-28,28,8,"+5",texte_cout_achat(p,5),peut_acheter_niveaux(p,5))
    bouton_niveau_mobile(38,y-28,28,8,"+10",texte_cout_achat(p,10),peut_acheter_niveaux(p,10))
    bouton_competence_mobile(74,y-28,54,8,"COMPÉTENCE "+p.competence+"/"+p.competence_max,texte_cout_competence(p),peut_acheter_competence(p))
  end

  dessiner_lignes_mobile = function(bloc)
    y = 102
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        dessiner_ligne_mobile(p,index,y)
        y = y - 58
      end

      index = index + 1
    end
  end

  dessiner_pc = function(bloc)
    screen.drawText("TV TYCOON CLICKER",0,92,11,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,80,9,"#FFD45A")

    if peut_bloc_gauche() then
      bouton(-150,67,20,16,"<","#39465C",7)
    end

    if peut_bloc_droite() then
      bouton(150,67,20,16,">","#39465C",7)
    end

    screen.drawText(bloc.nom,0,67,10,"#BFE1FF")

    screen.drawText("Programme",-150,57,4,"#8993A3")
    screen.drawText("Gain",-118,57,4,"#8993A3")
    screen.drawText("Niv",-82,57,4,"#8993A3")
    screen.drawText("Lancer / Prod / Auto",-8,57,4,"#8993A3")
    screen.drawText("Niveaux",90,57,4,"#8993A3")
    screen.drawText("Compétence",156,57,4,"#8993A3")

    dessiner_lignes_pc(bloc)

    screen.drawText(prochain_programme(bloc),0,-108,4,"#8993A3")
  end

  dessiner_mobile = function(bloc)
    screen.drawText("TV TYCOON CLICKER",0,174,12,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,160,10,"#FFD45A")

    if peut_bloc_gauche() then
      bouton(-82,152,28,24,"<","#39465C",8)
    end

    if peut_bloc_droite() then
      bouton(82,152,28,24,">","#39465C",8)
    end

    screen.drawText(bloc.nom,0,144,10,"#BFE1FF")

    dessiner_lignes_mobile(bloc)

    screen.drawText(prochain_programme(bloc),0,-146,5,"#8993A3")
  end

  dessiner = function()
    screen.clear("#151821")

    if GestionBlocs.blocs.length == 0 then
      return
    end

    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if est_mobile() then
      dessiner_mobile(bloc)
    else
      dessiner_pc(bloc)
    end
  end
end
