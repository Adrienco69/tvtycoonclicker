Interface = object
  dans_bouton = function(x,y,w,h)
    return mouse.x >= x-w/2 and mouse.x <= x+w/2 and mouse.y >= y-h/2 and mouse.y <= y+h/2
  end

  bouton = function(x,y,w,h,texte,couleur)
    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y,10,"#FFFFFF")
  end

  update = function()
    if not mouse.press then return end
    if GestionBlocs.blocs.length == 0 then return end

    local bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]
    if selection_production >= bloc.productions.length then selection_production = bloc.productions.length-1 end
    local p = bloc.productions[selection_production]

    if dans_bouton(-165,70,38,28) then
      if selection_production > 0 then selection_production -= 1 end
      return
    end

    if dans_bouton(165,70,38,28) then
      if selection_production + 1 < bloc.productions.length then
        if bloc.productions[selection_production+1].debloquee then
          selection_production += 1
        end
      end
      return
    end

    if dans_bouton(-165,105,38,24) then
      if GestionBlocs.bloc_actif > 0 then
        GestionBlocs.bloc_actif -= 1
        selection_production = 0
      end
      return
    end

    if dans_bouton(165,105,38,24) then
      local suivant = GestionBlocs.bloc_actif + 1
      if suivant < GestionBlocs.blocs.length then
        if GestionBlocs.blocs[suivant].debloque then
          GestionBlocs.bloc_actif = suivant
          selection_production = 0
        end
      end
      return
    end

    if not p.debloquee then return end

    if dans_bouton(0,15,220,52) then
      Production.lancer(p)
      return
    end

    if dans_bouton(-92,-52,160,38) then
      Production.acheter_niveau(p)
      return
    end

    if dans_bouton(92,-52,160,38) then
      Ameliorations.acheter(p)
      return
    end

    if dans_bouton(0,-102,220,34) then
      Ameliorations.recharger_auto(p)
      return
    end
  end

  dessiner = function()
    screen.clear("#151821")

    screen.drawText("TV TYCOON CLICKER",0,135,22,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,112,16,"#FFD45A")

    if GestionBlocs.blocs.length == 0 then return end

    local bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]
    local p = bloc.productions[selection_production]

    bouton(-165,105,38,24,"<","#39465C")
    bouton(165,105,38,24,">","#39465C")
    screen.drawText(bloc.nom,0,96,17,"#BFE1FF")

    bouton(-165,70,38,28,"<","#39465C")
    bouton(165,70,38,28,">","#39465C")

    if not p.debloquee then
      screen.drawText("Production verrouillée",0,35,18,"#AAAAAA")
      return
    end

    screen.drawText(p.bloc_nom+" "+p.numero,0,70,18,"#FFFFFF")
    screen.drawText("Niveau "+p.niveau+" / "+p.niveau_max,0,52,12,"#C8D0DE")
    screen.drawText("Gain : "+Production.gain_niveau(p)+" CC  (+"+p.gain_bonus+"%)",0,38,11,"#8FE59C")

    local texte_prod = "PRODUIRE"
    if p.en_cours then
      texte_prod = "Production : "+ceil(p.temps_restant)+" s"
    end
    bouton(0,15,220,52,texte_prod,"#2D8B62")

    local cout_niveau = Production.cout_suivant(p)
    if cout_niveau == 0 then
      bouton(-92,-52,160,38,"NIVEAU MAX","#555B66")
    else
      bouton(-92,-52,160,38,"NIVEAU +1  "+cout_niveau+" CC","#3C6FA8")
    end

    if p.amelioration >= p.amelioration_max then
      bouton(92,-52,160,38,"AMÉLIORATIONS MAX","#555B66")
    else
      local prix = Ameliorations.cout(p,p.amelioration+1)
      bouton(92,-52,160,38,"AMÉLIO "+(p.amelioration+1)+"  "+prix+" CC","#7652A8")
    end

    if p.auto_illimite then
      bouton(0,-102,220,34,"AUTOMATISATION ILLIMITÉE","#9A7726")
    elsif p.auto_duree_minutes > 0 then
      local auto_txt = "RECHARGER AUTO "+p.auto_duree_minutes+" min"
      if p.auto_restant > 0 then
        auto_txt = "AUTO : "+ceil(p.auto_restant)+" s restantes"
      end
      bouton(0,-102,220,34,auto_txt,"#9A7726")
    else
      bouton(0,-102,220,34,"AUTO À DÉBLOQUER","#555B66")
    end

    screen.drawText("Souris / tactile uniquement",0,-132,9,"#8993A3")
  end
end
