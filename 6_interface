Interface = object
  menu_ameliorations_ouvert = false

  est_mobile = function()
    if screen.height > screen.width then
      return true
    end

    if system.inputs.touch and not system.inputs.mouse then
      return true
    end

    return false
  end

  dans_bouton = function(x,y,w,h)
    return mouse.x >= x-w/2 and mouse.x <= x+w/2 and mouse.y >= y-h/2 and mouse.y <= y+h/2
  end

  bouton = function(x,y,w,h,texte,couleur,taille)
    screen.fillRect(x,y,w,h,couleur)
    screen.drawText(texte,x,y,taille,"#FFFFFF")
  end

  peut_bloc_gauche = function()
    return GestionBlocs.bloc_actif > 0
  end

  peut_bloc_droite = function()
    suivant = GestionBlocs.bloc_actif + 1
    if suivant >= GestionBlocs.blocs.length then
      return false
    end
    return GestionBlocs.blocs[suivant].debloque
  end

  production_selectionnee = function()
    if GestionBlocs.blocs.length == 0 then
      return 0
    end

    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if selection_production < 0 then
      selection_production = 0
    end

    if selection_production >= bloc.productions.length then
      selection_production = bloc.productions.length - 1
    end

    return bloc.productions[selection_production]
  end

  progression_production = function(p)
    if not p.en_cours then
      return 0
    end

    if p.temps_courant <= 0 then
      return 0
    end

    progression = 1 - p.temps_restant / p.temps_courant
    if progression < 0 then progression = 0 end
    if progression > 1 then progression = 1 end
    return progression
  end

  progression_auto = function(p)
    if p.auto_illimite then
      return 1
    end

    if p.auto_duree_minutes <= 0 then
      return 0
    end

    total = p.auto_duree_minutes * 60
    if total <= 0 then
      return 0
    end

    progression = p.auto_restant / total
    if progression < 0 then progression = 0 end
    if progression > 1 then progression = 1 end
    return progression
  end

  barre = function(x,y,w,h,progression,couleur_fond,couleur_remplissage)
    screen.fillRect(x,y,w,h,couleur_fond)

    if progression > 0 then
      largeur = w * progression
      debut = x - w/2 + largeur/2
      screen.fillRect(debut,y,largeur,h,couleur_remplissage)
    end
  end

  texte_auto_court = function(p)
    if p.auto_illimite then
      return "AUTO ∞"
    end

    if p.auto_duree_minutes <= 0 then
      return "AUTO -"
    end

    if p.auto_restant > 0 then
      return "AUTO "+ceil(p.auto_restant)+"s"
    end

    return "AUTO "+p.auto_duree_minutes+"m"
  end

  prochain_programme = function(bloc)
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]
      if not p.debloquee then
        if index > 0 then
          precedent = bloc.productions[index-1]
          seuil = precedent.numero * 50
          return "Prochain programme : niveau "+seuil
        end
      end
      index = index + 1
    end

    return "Tous les programmes du bloc sont débloqués"
  end

  texte_amelioration = function(p)
    if p.amelioration >= p.amelioration_max then
      return "AMÉLIORATIONS MAX"
    end

    prochain = p.amelioration + 1
    paire = floor(prochain / 2) * 2

    if paire != prochain then
      bonus = Ameliorations.bonus_gain_cible(p,prochain)
      return "Prochain bonus : +"+bonus+"% de gains"
    end

    minutes = Ameliorations.auto_minutes(p,prochain)
    if minutes == -1 then
      return "Prochain bonus : AUTO ILLIMITÉE"
    end

    return "Prochain bonus : AUTO "+minutes+" min"
  end

  bonus_actuel = function(p)
    texte = "Gains +"+p.gain_bonus+"%"

    if p.auto_illimite then
      return texte+" | Auto illimitée"
    end

    if p.auto_duree_minutes > 0 then
      return texte+" | Auto "+p.auto_duree_minutes+" min"
    end

    return texte+" | Auto non débloquée"
  end

  clic_bloc_pc = function()
    if peut_bloc_gauche() then
      if dans_bouton(-150,67,20,16) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif - 1
        selection_production = 0
        menu_ameliorations_ouvert = false
        return true
      end
    end

    if peut_bloc_droite() then
      if dans_bouton(150,67,20,16) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif + 1
        selection_production = 0
        menu_ameliorations_ouvert = false
        return true
      end
    end

    return false
  end

  clic_bloc_mobile = function()
    if peut_bloc_gauche() then
      if dans_bouton(-78,135,30,26) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif - 1
        selection_production = 0
        menu_ameliorations_ouvert = false
        return true
      end
    end

    if peut_bloc_droite() then
      if dans_bouton(78,135,30,26) then
        GestionBlocs.bloc_actif = GestionBlocs.bloc_actif + 1
        selection_production = 0
        menu_ameliorations_ouvert = false
        return true
      end
    end

    return false
  end

  update_lignes_pc = function(bloc)
    y = 47
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        if dans_bouton(0,y,340,12) then
          selection_production = index

          if mouse.x >= -5 and mouse.x <= 100 then
            Production.lancer(p)
            return true
          end

          if mouse.x >= 105 and mouse.x <= 175 then
            if p.auto_illimite or p.auto_duree_minutes > 0 then
              Ameliorations.recharger_auto(p)
            end
            return true
          end

          return true
        end

        y = y - 14
      end

      index = index + 1
    end

    return false
  end

  update_lignes_mobile = function(bloc)
    y = 105
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]

      if p.debloquee then
        if dans_bouton(0,y,188,20) then
          selection_production = index

          if mouse.x >= 0 then
            Production.lancer(p)
          end

          return true
        end

        y = y - 24
      end

      index = index + 1
    end

    return false
  end

  update_panneau_pc = function(p)
    if dans_bouton(85,-2,18,16) then
      menu_ameliorations_ouvert = false
      return
    end

    if p.amelioration < p.amelioration_max then
      if dans_bouton(0,-35,120,20) then
        Ameliorations.acheter(p)
      end
    end
  end

  update_panneau_mobile = function(p)
    if dans_bouton(88,-35,24,22) then
      menu_ameliorations_ouvert = false
      return
    end

    if p.amelioration < p.amelioration_max then
      if dans_bouton(0,-100,160,28) then
        Ameliorations.acheter(p)
      end
    end
  end

  update_pc = function()
    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]
    p = production_selectionnee()

    if p == 0 then return end

    if menu_ameliorations_ouvert then
      update_panneau_pc(p)
      return
    end

    if clic_bloc_pc() then return end
    if update_lignes_pc(bloc) then return end

    if dans_bouton(-58,-82,100,18) then
      Production.acheter_niveau(p)
      return
    end

    if dans_bouton(58,-82,100,18) then
      menu_ameliorations_ouvert = true
      return
    end
  end

  update_mobile = function()
    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]
    p = production_selectionnee()

    if p == 0 then return end

    if menu_ameliorations_ouvert then
      update_panneau_mobile(p)
      return
    end

    if clic_bloc_mobile() then return end
    if update_lignes_mobile(bloc) then return end

    if dans_bouton(0,-130,170,28) then
      Production.acheter_niveau(p)
      return
    end

    if dans_bouton(0,-164,170,28) then
      menu_ameliorations_ouvert = true
      return
    end
  end

  update = function()
    if not mouse.press then return end
    if GestionBlocs.blocs.length == 0 then return end

    if est_mobile() then
      update_mobile()
    else
      update_pc()
    end
  end

  dessiner_ligne_pc = function(p,index,y)
    selection = index == selection_production

    if selection then
      screen.fillRect(0,y,342,13,"#283247")
    end

    screen.drawText(p.bloc_nom+" "+p.numero,-145,y,6,"#FFFFFF")
    screen.drawText("Gain "+Production.gain_niveau(p)+" CC",-82,y,5,"#8FE59C")
    screen.drawText("Niv "+p.niveau+"/"+p.niveau_max,-25,y,5,"#C8D0DE")

    prod = progression_production(p)
    barre(48,y,100,8,prod,"#38414F","#2D8B62")

    if p.en_cours then
      screen.drawText(ceil(p.temps_restant)+"s",48,y,4,"#FFFFFF")
    else
      screen.drawText("PROD",48,y,4,"#FFFFFF")
    end

    auto = progression_auto(p)
    barre(137,y,66,8,auto,"#38414F","#9A7726")
    screen.drawText(texte_auto_court(p),137,y,4,"#FFFFFF")
  end

  dessiner_lignes_pc = function(bloc)
    y = 47
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]
      if p.debloquee then
        dessiner_ligne_pc(p,index,y)
        y = y - 14
      end
      index = index + 1
    end
  end

  dessiner_ligne_mobile = function(p,index,y)
    selection = index == selection_production

    if selection then
      screen.fillRect(0,y,194,21,"#283247")
    end

    screen.drawText(p.bloc_nom+" "+p.numero,-67,y+5,6,"#FFFFFF")
    screen.drawText("Gain "+Production.gain_niveau(p)+" | Niv "+p.niveau+"/"+p.niveau_max,24,y+5,5,"#C8D0DE")

    prod = progression_production(p)
    barre(16,y-5,100,7,prod,"#38414F","#2D8B62")

    auto = progression_auto(p)
    barre(73,y-5,44,7,auto,"#38414F","#9A7726")
  end

  dessiner_lignes_mobile = function(bloc)
    y = 105
    index = 0

    while index < bloc.productions.length
      p = bloc.productions[index]
      if p.debloquee then
        dessiner_ligne_mobile(p,index,y)
        y = y - 24
      end
      index = index + 1
    end
  end

  dessiner_panneau_pc = function(p)
    screen.fillRect(0,-15,185,94,"#202637")
    screen.drawText("AMÉLIORATIONS",0,16,8,"#FFFFFF")
    bouton(85,-2,18,16,"X","#555B66",6)
    screen.drawText(p.bloc_nom+" "+p.numero,0,3,6,"#BFE1FF")
    screen.drawText("Niveau amélioration : "+p.amelioration+" / "+p.amelioration_max,0,-9,5,"#D9E2F0")
    screen.drawText(bonus_actuel(p),0,-20,5,"#8FE59C")
    screen.drawText(texte_amelioration(p),0,-30,5,"#D9E2F0")

    if p.amelioration < p.amelioration_max then
      prix = Ameliorations.cout(p,p.amelioration+1)
      bouton(0,-45,120,18,"ACHETER = "+prix+" CC","#7652A8",5)
    else
      bouton(0,-45,120,18,"AMÉLIORATIONS MAX","#555B66",5)
    end
  end

  dessiner_panneau_mobile = function(p)
    screen.fillRect(0,-65,194,116,"#202637")
    screen.drawText("AMÉLIORATIONS",0,-20,10,"#FFFFFF")
    bouton(88,-35,24,22,"X","#555B66",8)
    screen.drawText(p.bloc_nom+" "+p.numero,0,-42,8,"#BFE1FF")
    screen.drawText("Niveau "+p.amelioration+" / "+p.amelioration_max,0,-57,7,"#D9E2F0")
    screen.drawText(bonus_actuel(p),0,-72,6,"#8FE59C")
    screen.drawText(texte_amelioration(p),0,-86,6,"#D9E2F0")

    if p.amelioration < p.amelioration_max then
      prix = Ameliorations.cout(p,p.amelioration+1)
      bouton(0,-105,160,28,"ACHETER = "+prix+" CC","#7652A8",8)
    else
      bouton(0,-105,160,28,"AMÉLIORATIONS MAX","#555B66",8)
    end
  end

  dessiner_pc = function(bloc)
    screen.drawText("TV TYCOON CLICKER",0,92,11,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,80,9,"#FFD45A")

    if peut_bloc_gauche() then
      bouton(-150,67,20,16,"<","#39465C",7)
    end

    if peut_bloc_droite() then
      bouton(150,67,20,16,">","#39465C",7)
    end

    screen.drawText(bloc.nom,0,67,10,"#BFE1FF")

    screen.drawText("Programme",-145,57,4,"#8993A3")
    screen.drawText("Gain",-82,57,4,"#8993A3")
    screen.drawText("Niveau",-25,57,4,"#8993A3")
    screen.drawText("Production",48,57,4,"#8993A3")
    screen.drawText("Auto",137,57,4,"#8993A3")

    dessiner_lignes_pc(bloc)

    p = production_selectionnee()
    if p != 0 then
      cout = Production.cout_suivant(p)
      if cout == 0 then
        bouton(-58,-82,100,18,"NIVEAU MAX","#555B66",5)
      else
        bouton(-58,-82,100,18,"NIV +1 = "+cout+" CC","#3C6FA8",5)
      end

      bouton(58,-82,100,18,"AMÉLIORATIONS","#7652A8",5)
    end

    screen.drawText(prochain_programme(bloc),0,-96,5,"#8993A3")

    if menu_ameliorations_ouvert and p != 0 then
      dessiner_panneau_pc(p)
    end
  end

  dessiner_mobile = function(bloc)
    screen.drawText("TV TYCOON CLICKER",0,174,15,"#FFFFFF")
    screen.drawText("CC : "+floor(Economie.cc),0,155,11,"#FFD45A")

    if peut_bloc_gauche() then
      bouton(-78,135,30,26,"<","#39465C",10)
    end

    if peut_bloc_droite() then
      bouton(78,135,30,26,">","#39465C",10)
    end

    screen.drawText(bloc.nom,0,135,12,"#BFE1FF")

    dessiner_lignes_mobile(bloc)

    p = production_selectionnee()
    if p != 0 then
      cout = Production.cout_suivant(p)
      if cout == 0 then
        bouton(0,-130,170,28,"NIVEAU MAX","#555B66",8)
      else
        bouton(0,-130,170,28,"NIVEAU +1 = "+cout+" CC","#3C6FA8",8)
      end

      bouton(0,-164,170,28,"AMÉLIORATIONS","#7652A8",8)
    end

    if menu_ameliorations_ouvert and p != 0 then
      dessiner_panneau_mobile(p)
    end
  end

  dessiner = function()
    screen.clear("#151821")

    if GestionBlocs.blocs.length == 0 then
      return
    end

    bloc = GestionBlocs.blocs[GestionBlocs.bloc_actif]

    if est_mobile() then
      dessiner_mobile(bloc)
    else
      dessiner_pc(bloc)
    end
  end
end
