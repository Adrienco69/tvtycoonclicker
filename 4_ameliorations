Ameliorations = object
  cout = function(p, prochain_niveau)
    if prochain_niveau < 1 then
      prochain_niveau = 1
    end

    return floor(p.gain_base * 4 * (2 ^ (prochain_niveau - 1)))
  end

  get = function(p,niveau)
    return Donnees.get_competence(p.bloc_id,niveau)
  end

  acheter = function(p)
    if p.competence >= p.competence_max then
      return false
    end

    prochain = p.competence + 1
    competence = get(p,prochain)

    if competence == 0 then
      return false
    end

    prix = cout(p,prochain)

    if Economie.cc < prix then
      return false
    end

    Economie.cc = Economie.cc - prix
    p.competence = prochain

    if competence.type == "gain_fixe" then
      p.gain_competence = p.gain_competence + competence.valeur

    elsif competence.type == "auto" then
      p.auto_duree_minutes = competence.valeur

    elsif competence.type == "auto_infini" then
      p.auto_illimite = true
      p.auto_duree_minutes = 0
      p.auto_restant = 0
    end

    return true
  end

  recharger_auto = function(p)
    if p.auto_illimite then
      return true
    end

    if p.auto_duree_minutes <= 0 then
      return false
    end

    p.auto_restant = p.auto_duree_minutes * 60

    if not p.en_cours then
      Production.lancer(p)
    end

    return true
  end
end
