Ameliorations = object
  cout = function(p, prochain_niveau)
    if prochain_niveau < 1 then
      prochain_niveau = 1
    end

    return floor(p.gain_base * 4 * (2 ^ (prochain_niveau - 1)))
  end

  niveau_requis = function(p,niveau_competence)
    if niveau_competence < 1 then
      niveau_competence = 1
    end

    requis = round(niveau_competence * 100 / 11)

    if requis < 1 then
      requis = 1
    end

    if requis > p.niveau_max then
      requis = p.niveau_max
    end

    return requis
  end

  debloquee = function(p,niveau_competence)
    requis = niveau_requis(p,niveau_competence)
    return p.niveau >= requis
  end

  get = function(p,niveau)
    return Donnees.get_competence(p.bloc_id,niveau)
  end

  recalculer = function(p)
    p.gain_competence = 0
    p.auto_duree_minutes = 0
    p.auto_illimite = false

    niveau = 1

    while niveau <= p.competence
      competence = get(p,niveau)

      if competence != 0 then
        if competence.effet == "gain_fixe" then
          p.gain_competence = p.gain_competence + competence.valeur
        elsif competence.effet == "auto" then
          p.auto_duree_minutes = competence.valeur
        elsif competence.effet == "auto_infini" then
          p.auto_illimite = true
          p.auto_duree_minutes = 0
        end
      end

      niveau = niveau + 1
    end
  end

  acheter = function(p)
    if p.competence >= p.competence_max then
      return false
    end

    prochain = p.competence + 1

    if not debloquee(p,prochain) then
      return false
    end

    competence = get(p,prochain)

    if competence == 0 then
      return false
    end

    prix = cout(p,prochain)

    if Economie.cc < prix then
      return false
    end

    Economie.cc = Economie.cc - prix
    p.competence = prochain

    recalculer(p)

    if competence.effet == "auto" or competence.effet == "auto_infini" then
      if p.auto_illimite then
        if not p.en_cours then
          Production.lancer(p)
        end
      else
        p.auto_restant = p.auto_duree_minutes * 60

        if not p.en_cours then
          Production.lancer(p)
        end
      end
    end

    return true
  end

  recharger_auto = function(p)
    recalculer(p)

    if p.auto_illimite then
      if not p.en_cours then
        Production.lancer(p)
      end
      return true
    end

    if p.auto_duree_minutes <= 0 then
      return false
    end

    p.auto_restant = p.auto_duree_minutes * 60

    if not p.en_cours then
      Production.lancer(p)
    end

    return true
  end
end