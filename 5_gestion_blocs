GestionBlocs = object
  blocs = []
  bloc_actif = 0

  initialiser = function()
    blocs = []

    for config in Parametres.blocs
      local bloc = object end
      bloc.id = config.id
      bloc.nom = config.nom
      bloc.total = config.total
      bloc.debloque = false
      bloc.productions = []

      local numero = 1
      while numero <= config.total
        bloc.productions.push(Production.creer(config, numero))
        numero += 1
      end

      blocs.push(bloc)
    end

    if blocs.length > 0 then
      blocs[0].debloque = true
      blocs[0].productions[0].debloquee = true
      bloc_actif = 0
    end
  end

  verifier_deblocages = function()
    local bindex = 0

    while bindex < blocs.length
      local bloc = blocs[bindex]

      if bloc.debloque then
        local i = 0
        while i < bloc.productions.length
          local p = bloc.productions[i]

          if p.debloquee and i + 1 < bloc.productions.length then
            local seuil = p.numero * 10
            if p.niveau >= seuil then
              bloc.productions[i + 1].debloquee = true
            end
          end

          i += 1
        end

        if bindex + 1 < blocs.length then
          local cible_index = bloc.total - 5
          if cible_index >= 0 and bloc.productions[cible_index].debloquee then
            blocs[bindex + 1].debloque = true
            blocs[bindex + 1].productions[0].debloquee = true
          end
        end
      end

      bindex += 1
    end
  end

  update = function(dt)
    for bloc in blocs
      if bloc.debloque then
        for p in bloc.productions
          if p.debloquee then
            if p.auto_restant > 0 then
              p.auto_restant -= dt
              if p.auto_restant < 0 then p.auto_restant = 0 end
            end

            local auto_actif = p.auto_illimite or p.auto_restant > 0

            if auto_actif and not p.en_cours then
              Production.lancer(p)
            end

            if p.en_cours then
              p.temps_restant -= dt

              if p.temps_restant <= 0 then
                Economie.ajouter(Production.gain_niveau(p))

                if auto_actif then
                  p.temps_courant = Production.temps_niveau(p)
                  p.temps_restant = p.temps_courant
                  p.en_cours = true
                else
                  p.temps_restant = 0
                  p.en_cours = false
                end
              end
            end
          end
        end
      end
    end

    verifier_deblocages()
  end
end
